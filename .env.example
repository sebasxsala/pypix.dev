# secure password, can use `openssl rand -hex 32`
NUXT_SESSION_PASSWORD=""

# HMAC secret for image-proxy and OG image URL signing, can use `openssl rand -hex 32`
NUXT_IMAGE_PROXY_SECRET=""

# Enable Nitro runtime cache on Vercel. Production uses Upstash for shared cache when configured.
RUNTIME_CACHE=""

# Upstash Redis / Vercel KV REST credentials
UPSTASH_KV_REST_API_URL=""
UPSTASH_KV_REST_API_TOKEN=""

# Algolia search index for PyPI package search
ALGOLIA_APP_ID=""
ALGOLIA_INDEX_NAME="pypix_packages"

# Search-only key. Used server-side by /api/pypi/search in v1.
ALGOLIA_SEARCH_API_KEY=""

# Admin key. Only for indexing jobs/scripts. Never expose to client/runtime public config.
ALGOLIA_ADMIN_API_KEY=""

# Optional indexing controls
PYPI_INDEX_BATCH_SIZE="100"
PYPI_INDEX_CONCURRENCY="5"
PYPI_INDEX_TARGET_RECORDS="90000"
PYPI_INDEX_MODE="balanced"
PYPI_INDEX_PROJECTS_FILE="scripts/pypi-seed-packages.txt"
PYPI_INDEX_SAVE_BATCH_SIZE="1000"
PYPI_INDEX_BATCH_DELAY_MS="0"
PYPI_INDEX_WAIT_FOR_TASKS="true"
