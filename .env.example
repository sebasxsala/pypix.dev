# secure password, can use `openssl rand -hex 32`
NUXT_SESSION_PASSWORD=""

# HMAC secret for image-proxy and OG image URL signing, can use `openssl rand -hex 32`
NUXT_IMAGE_PROXY_SECRET=""

# Enable Nitro runtime cache on Vercel. Production uses Upstash for shared cache when configured.
RUNTIME_CACHE=""

# Upstash Redis / Vercel KV REST credentials
UPSTASH_KV_REST_API_URL=""
UPSTASH_KV_REST_API_TOKEN=""
